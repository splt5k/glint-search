{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glint",
  "version": "2.6.2",
  "identifier": "dev.maykom.glint",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glint",
        "width": 860,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Busca rápida de apps, arquivos e ações, com visual de vidro translúcido.",
    "longDescription": "Glint abre com um atalho global e busca aplicativos, arquivos, ações, área de transferência, cálculos e conversões, com visual de vidro translúcido. Windows e Linux.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RDUzRjE5QUYyMTI3NjgKUldSb0p5R3ZHVC9WaUU1TXBJeVc0dkt1ekJNa3FRaTVpdXRRWnRRQi80bWNvQmdRekU3cCt3dmgK",
      "endpoints": [
        "https://github.com/splt5k/glint-search/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}